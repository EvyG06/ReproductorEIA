<?xml version="1.0" encoding="UTF-8"?>

<?import com.eia.reproductor.ui.ControlEstrellas?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.shape.SVGPath?>

<HBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.eia.reproductor.ui.ReproductorController"
      styleClass="root-pane" prefWidth="1280" prefHeight="800">

    <!-- SIDEBAR -->
    <VBox styleClass="sidebar" prefWidth="340" spacing="16">
        <padding><Insets top="28" right="24" bottom="24" left="24"/></padding>

        <Label text="Reproductor EIA" styleClass="titulo-app"/>
        <Label fx:id="lblContador" text="Biblioteca · 0 canciones" styleClass="texto-muted"/>

        <TextField fx:id="txtBuscar" promptText="Buscar canción o artista..." styleClass="buscador"/>

        <HBox fx:id="filtrosBox" spacing="6">
            <ToggleButton fx:id="filtroTodos" text="Todos" styleClass="chip-filtro" selected="true"/>
            <ToggleButton fx:id="filtroGenero" text="Género" styleClass="chip-filtro"/>
            <ToggleButton fx:id="filtroArtista" text="Artista" styleClass="chip-filtro"/>
            <ToggleButton fx:id="filtroFavoritos" text="♥ Favoritos" styleClass="chip-filtro"/>
        </HBox>

        <ListView fx:id="listaCanciones" styleClass="lista-canciones" VBox.vgrow="ALWAYS"/>

        <HBox spacing="8">
            <Button fx:id="btnAgregar" text="Agregar" styleClass="btn-primario" HBox.hgrow="ALWAYS" maxWidth="Infinity" onAction="#onAgregar"/>
            <Button fx:id="btnEliminar" text="Eliminar" styleClass="btn-secundario" HBox.hgrow="ALWAYS" maxWidth="Infinity" onAction="#onEliminar"/>
            <Button fx:id="btnEditar" text="Editar" styleClass="btn-secundario" HBox.hgrow="ALWAYS" maxWidth="Infinity" onAction="#onEditar"/>
        </HBox>
    </VBox>

    <!-- ÁREA PRINCIPAL -->
    <VBox styleClass="main-area" alignment="TOP_CENTER" spacing="24" HBox.hgrow="ALWAYS">
        <padding><Insets top="28" right="48" bottom="32" left="48"/></padding>

        <HBox spacing="10" alignment="CENTER_LEFT" maxWidth="Infinity">
            <ToggleButton fx:id="modoAleatorio" text="Aleatorio" styleClass="chip-modo" selected="true"/>
            <ToggleButton fx:id="modoLlegada" text="Orden de llegada" styleClass="chip-modo"/>
            <ToggleButton fx:id="modoAlfabetico" text="Alfabético" styleClass="chip-modo"/>
        </HBox>

        <StackPane fx:id="portadaPane" styleClass="portada" prefWidth="280" prefHeight="280"
                   maxWidth="280" maxHeight="280">
            <ImageView fx:id="imgPortada" fitWidth="280" fitHeight="280" preserveRatio="true"/>
            <Label fx:id="lblPortadaFallback" text="♪" styleClass="portada-glifo"/>
            <StackPane styleClass="emblema" maxWidth="52" maxHeight="52"
                       translateY="-26" StackPane.alignment="TOP_CENTER">
                <SVGPath styleClass="emblema-abanico"
                         content="M 3 17 C 3 9.54 9.04 3.5 16.5 3.5 C 23.96 3.5 30 9.54 30 17 L 26 19 L 7 19 Z M 14.2 19 L 18.8 19 L 17.6 30 L 15.4 30 Z"/>
            </StackPane>
            <HBox fx:id="ecualizador" spacing="3" alignment="BOTTOM_CENTER" maxHeight="20" maxWidth="40"
                  StackPane.alignment="BOTTOM_CENTER" translateY="-14" visible="false" managed="false">
                <Rectangle fx:id="barra1" width="4" height="8" arcWidth="2" arcHeight="2" styleClass="barra-ecualizador"/>
                <Rectangle fx:id="barra2" width="4" height="14" arcWidth="2" arcHeight="2" styleClass="barra-ecualizador"/>
                <Rectangle fx:id="barra3" width="4" height="10" arcWidth="2" arcHeight="2" styleClass="barra-ecualizador"/>
                <Rectangle fx:id="barra4" width="4" height="16" arcWidth="2" arcHeight="2" styleClass="barra-ecualizador"/>
            </HBox>
        </StackPane>

        <VBox alignment="CENTER" spacing="6">
            <Label fx:id="lblNombre" text="Sin reproducción" styleClass="titulo-cancion"/>
            <Label fx:id="lblMeta" text="Agrega canciones para comenzar" styleClass="texto-muted-grande"/>
            <HBox alignment="CENTER" spacing="10">
                <ControlEstrellas fx:id="estrellasPanel" visible="false" managed="false"/>
                <Label fx:id="lblCalificacion" text="" styleClass="texto-acento"/>
            </HBox>
        </VBox>

        <VBox spacing="6" maxWidth="560">
            <ProgressBar fx:id="barraProgreso" progress="0" maxWidth="Infinity" styleClass="progreso"/>
            <HBox>
                <Label fx:id="lblTiempoActual" text="0:00" styleClass="texto-muted"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblTiempoTotal" text="0:00" styleClass="texto-muted"/>
            </HBox>
        </VBox>

        <HBox spacing="18" alignment="CENTER">
            <Button fx:id="btnAnterior" text="◀◀" styleClass="ctrl" onAction="#onAnterior"/>
            <Button fx:id="btnPausar" text="❚❚" styleClass="ctrl" onAction="#onPausar"/>
            <Button fx:id="btnReproducir" text="▶" styleClass="ctrl-primario" onAction="#onReproducir"/>
            <Button fx:id="btnSiguiente" text="▶▶" styleClass="ctrl" onAction="#onSiguiente"/>
        </HBox>
    </VBox>
</HBox>